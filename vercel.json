{
  "rewrites": [
    { "source": "/admin", "destination": "/admin/index.html" },
    { "source": "/admin/track-images", "destination": "/admin/track-images.html" },
    { "source": "/admin/driver-photos", "destination": "/admin/driver-photos.html" },
    { "source": "/admin/standing-driver-photos", "destination": "/admin/standing-driver-photos.html" },
    { "source": "/admin/power-rankings", "destination": "/admin/power-rankings.html" },
    { "source": "/admin/news", "destination": "/admin/news.html" },
    { "source": "/admin/transcripts", "destination": "/admin/transcripts.html" },
    { "source": "/news/:slug", "destination": "/news-article.html?slug=:slug" },
    { "source": "/drivers/:driverId", "destination": "/driver-profile.html?driverId=:driverId" },
    { "source": "/streamview", "destination": "/streamview.html" }
  ]
}
