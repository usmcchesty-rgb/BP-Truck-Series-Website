SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Optional: path to installed Google Chrome (Windows defaults are used when unset)
# CHROME_EXECUTABLE_PATH=C:\Program Files\Google\Chrome\Application\chrome.exe

# Optional: override iRacing login URL
# IRACING_LOGIN_URL=https://members.iracing.com/membersite/login.jsp

# Optional: set to true to run browser without a visible window
# HEADLESS=false

# Optional: delay in ms between consecutive jobs (default 3000)
# JOB_DELAY_MS=3000
